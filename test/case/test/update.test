CREATE TABLE update_check(id int, age int, name char(8), score float);
INSERT INTO update_check VALUES (1, 10, 'name1', 1.5);
INSERT INTO update_check VALUES (2, 20, 'name2', 2.5);
INSERT INTO update_check VALUES (3, 30, 'name3', 3.5);
INSERT INTO update_check VALUES (4, 40, 'name4', 4.5);
CREATE INDEX update_id ON update_check(id);
CREATE INDEX update_name ON update_check(name);
UPDATE update_check SET name='a' WHERE id=1;
-- sort SELECT * FROM update_check;
UPDATE update_check SET age=-7 WHERE id>1 AND id<4;
UPDATE update_check SET score=9 WHERE age=-7;
-- sort SELECT * FROM update_check;
UPDATE update_check SET id=8 WHERE id<>1;
-- sort SELECT * FROM update_check WHERE id=8;
-- sort SELECT * FROM update_check WHERE id=2;
UPDATE update_check SET id=9 WHERE id=8;
-- sort SELECT * FROM update_check WHERE id=8;
-- sort SELECT * FROM update_check WHERE id=9;
UPDATE update_check SET id=9 WHERE id=9;
UPDATE update_check SET name='' WHERE 9=id AND age<0;
-- sort SELECT * FROM update_check WHERE name='';
-- sort SELECT * FROM update_check WHERE name='name2';
UPDATE update_check SET name='12345678' WHERE id!=9;
-- sort SELECT * FROM update_check WHERE name='12345678';
UPDATE update_check SET name='x' WHERE name='12345678';
-- sort SELECT * FROM update_check WHERE name='x';
-- sort SELECT * FROM update_check WHERE name='12345678';
UPDATE update_check SET age=0;
UPDATE update_check SET age=88 WHERE 1=0;
UPDATE update_check SET score=-2.25 WHERE 1=1;
UPDATE update_check SET id=100 WHERE id=99;
-- sort SELECT * FROM update_check;
UPDATE update_missing SET age=1;
UPDATE update_check SET missing=1;
UPDATE update_check SET age=1 WHERE missing=1;
UPDATE update_check SET age=1 WHERE other.id=1;
UPDATE update_check SET age='bad';
UPDATE update_check SET age='bad' WHERE id=1000;
UPDATE update_check SET name=10 WHERE id=1;
-- sort SELECT * FROM update_check;
CREATE TABLE update_empty(id int, age int);
UPDATE update_empty SET age=1;
UPDATE update_empty SET age='bad';
UPDATE update_empty SET age=1 WHERE missing=0;
CREATE INDEX update_age ON update_check(age);
UPDATE update_check SET age=3 WHERE age=0;
-- sort SELECT * FROM update_check WHERE age=0;
DELETE FROM update_check WHERE age=3;
-- sort SELECT * FROM update_check;
INSERT INTO update_check VALUES (1,2,'again',3.5);
UPDATE update_check SET name='end';
-- sort SELECT * FROM update_check WHERE id=1;
SET execution_mode='CHUNK_ITERATOR';
UPDATE update_check SET age=7 WHERE id=1;
SET execution_mode='TUPLE_ITERATOR';
-- sort SELECT * FROM update_check;
