CREATE TABLE t_date(id int, d date);
CREATE INDEX i_date ON t_date(d);
INSERT INTO t_date VALUES(1,'1970-1-1');
INSERT INTO t_date VALUES(2,'2000-2-29');
INSERT INTO t_date VALUES(3,'2020-1-01');
INSERT INTO t_date VALUES(4,'2020-01-1');
-- sort SELECT * FROM t_date;
-- sort SELECT * FROM t_date WHERE d='2020-1-1';
-- sort SELECT * FROM t_date WHERE '2000-2-29'<d;
-- sort SELECT * FROM t_date WHERE d<>'2000-2-29';
INSERT INTO t_date VALUES(5,'1900-2-29');
SELECT * FROM t_date WHERE d='2017-11-31';
DELETE FROM t_date WHERE d='2020-1-1';
-- sort SELECT * FROM t_date;
DELETE FROM t_date WHERE d<'2001-1-1';
SELECT * FROM t_date;
SELECT * FROM t_date WHERE d='2021-2-29';
CREATE TABLE t_date_chars(c char(20));
INSERT INTO t_date_chars VALUES('2017-2-29');
SELECT * FROM t_date_chars WHERE c='2017-2-29';
